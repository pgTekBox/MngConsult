# ---------------------------------------------------------------------
# Fichiers à ne pas versionner (Visual Studio / .NET)
# ---------------------------------------------------------------------

# Configuration locale : contient les chaînes de connexion et les secrets.
web.config

# Sorties de compilation
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/

# Dépendances NuGet restaurées (packages.config, lui, reste versionné)
packages/

# État local de Visual Studio (disposition des fenêtres, cache, options)
.vs/
*.suo
*.user
*.userprefs

# Sorties de publication
[Pp]ublish/
PublishProfiles/*.pubxml.user

# Certificats et cles de signature.
# Un .pfx contient la cle PRIVEE : une fois pousse, il est compromis, et le
# retirer du depot ne le decompromet pas — il faut le remplacer.
# Ces fichiers restent sur le poste et sur le serveur, jamais dans git.
*.pfx
*.p12
*.snk
*.pem

# Fichiers temporaires
*.tmp
*~
Thumbs.db
desktop.ini

# Fichiers deposes a l'execution (televersements temporaires de l'ERP)
**/App_Data/TempUploads/

# Detritus divers (dossier temporaire de git, vidage memoire de bash)
_program files_git_*/
*.stackdump

# Espace de travail Claude Code (sessions, worktrees)
.claude/
