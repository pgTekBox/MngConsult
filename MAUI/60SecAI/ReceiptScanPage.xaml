<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="_60SecAI.ReceiptScanPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F2F0FB, Dark=#141221}">

    <Grid RowDefinitions="Auto,*">

        <!-- En-tête simple avec retour -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="16,14">
            <Label Grid.Column="0" Text="&#8249;" FontSize="26"
                   TextColor="{StaticResource Primary}" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Scanner un reçu" FontSize="20" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">

                <Button x:Name="ScanButton"
                        Text="📄 Scanner un reçu (cadrage auto)"
                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                        FontAttributes="Bold" HeightRequest="52" CornerRadius="14"
                        Clicked="OnScanClicked" />

                <Label x:Name="lblStatus" FontSize="14"
                       TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />

                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}"
                        StrokeThickness="0" Padding="8">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <Image x:Name="imgPreview" HeightRequest="320" Aspect="AspectFit"
                           BackgroundColor="#1E1E1E" />
                </Border>

                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}"
                        StrokeThickness="0" Padding="12">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <Label x:Name="lblSize" FontSize="12" TextColor="{StaticResource Gray400}" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
