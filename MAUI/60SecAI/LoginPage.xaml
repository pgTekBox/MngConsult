<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:_60SecAI.Localization"
             x:Class="_60SecAI.LoginPage"
             Shell.NavBarIsVisible="False">

    <!-- Fond en dégradé -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5B2BD6" Offset="0.0" />
                <GradientStop Color="#8E2DE2" Offset="0.55" />
                <GradientStop Color="#C724B1" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Formes décoratives -->
        <Ellipse Fill="#22FFFFFF" WidthRequest="260" HeightRequest="260"
                 HorizontalOptions="Start" VerticalOptions="Start"
                 TranslationX="-90" TranslationY="-70" />
        <Ellipse Fill="#1AFFFFFF" WidthRequest="200" HeightRequest="200"
                 HorizontalOptions="End" VerticalOptions="Start"
                 TranslationX="70" TranslationY="40" />
        <Ellipse Fill="#1AFFFFFF" WidthRequest="300" HeightRequest="300"
                 HorizontalOptions="End" VerticalOptions="End"
                 TranslationX="110" TranslationY="120" />

        <ScrollView>
            <Grid Padding="24" RowDefinitions="*,Auto,*">

                <!-- Carte flottante -->
                <Border Grid.Row="1"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="24,28">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.25" Radius="30" Offset="0,14" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="18">

                        <!-- Sélecteur de langue -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Border BackgroundColor="{Binding FrBg}" StrokeThickness="0" Padding="12,6">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetLanguageCommand}" CommandParameter="fr" />
                                </Border.GestureRecognizers>
                                <Label Text="Français" FontSize="12" FontAttributes="Bold" TextColor="#8E2DE2" />
                            </Border>
                            <Border BackgroundColor="{Binding EnBg}" StrokeThickness="0" Padding="12,6">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                                </Border.GestureRecognizers>
                                <Label Text="English" FontSize="12" FontAttributes="Bold" TextColor="#8E2DE2" />
                            </Border>
                            <Border BackgroundColor="{Binding EsBg}" StrokeThickness="0" Padding="12,6">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetLanguageCommand}" CommandParameter="es" />
                                </Border.GestureRecognizers>
                                <Label Text="Español" FontSize="12" FontAttributes="Bold" TextColor="#8E2DE2" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Logo -->
                        <Border WidthRequest="84" HeightRequest="84"
                                HorizontalOptions="Center"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6A2CDE" Offset="0.0" />
                                    <GradientStop Color="#C724B1" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="#8E2DE2" Opacity="0.5" Radius="18" Offset="0,8" />
                            </Border.Shadow>
                            <Label Text="60&#10;AI"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="26"
                                   LineHeight="1"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="60 Sec AI"
                                   TextColor="#1F1F1F"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{loc:Translate LoginSubtitle}"
                                   TextColor="#8A8A8A"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Champ utilisateur -->
                        <Border BackgroundColor="#F4F5F8" StrokeThickness="0" Padding="14,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="&#128100;" FontSize="16" VerticalOptions="Center" />
                                <Entry Grid.Column="1" x:Name="UserEntry"
                                       Text="{Binding Username}"
                                       Keyboard="Email"
                                       Placeholder="{loc:Translate UsernamePlaceholder}" PlaceholderColor="#A6A6B3"
                                       BackgroundColor="Transparent" TextColor="#1F1F1F"
                                       HeightRequest="50" />
                            </Grid>
                        </Border>

                        <!-- Champ mot de passe -->
                        <Border BackgroundColor="#F4F5F8" StrokeThickness="0" Padding="14,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="&#128274;" FontSize="16" VerticalOptions="Center" />
                                <Entry Grid.Column="1" x:Name="PasswordEntry"
                                       Text="{Binding Password}"
                                       Placeholder="{loc:Translate PasswordPlaceholder}" PlaceholderColor="#A6A6B3"
                                       IsPassword="{Binding IsPasswordHidden}"
                                       BackgroundColor="Transparent" TextColor="#1F1F1F"
                                       HeightRequest="50" />
                                <Label Grid.Column="2" x:Name="EyeLabel" Text="&#128065;" FontSize="16"
                                       TextColor="#8A8A8A" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>

                        <!-- Mot de passe oublié -->
                        <Label Text="{loc:Translate ForgotPassword}"
                               TextColor="#8E2DE2"
                               FontSize="12"
                               HorizontalOptions="End">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- Message d'erreur -->
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="#C0392B"
                               FontSize="12"
                               IsVisible="{Binding HasError}"
                               HorizontalTextAlignment="Center" />

                        <!-- Bouton -->
                        <Border StrokeThickness="0" HeightRequest="52">
                            <Border.StrokeShape><RoundRectangle CornerRadius="26" /></Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#6A2CDE" Offset="0.0" />
                                    <GradientStop Color="#C724B1" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding LoginCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="{loc:Translate SignIn}"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="#8E2DE2"
                                           HeightRequest="22" />

                        <Label Text="Version 1.0"
                               TextColor="#B8B8C4"
                               FontSize="11"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>

</ContentPage>
