                        <VerticalStackLayout Spacing="10">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{loc:Translate AccountsReceivableTitle}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding TotalClientsText}" FontSize="15" FontAttributes="Bold" TextColor="#1E8449" VerticalOptions="Center" />
                            </Grid>

                            <!-- Aging -->
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="{loc:Translate Aging0_30}" FontSize="10" TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                                <Grid Grid.Column="1" HeightRequest="8" VerticalOptions="Center">
                                    <Border BackgroundColor="{AppThemeBinding Light=#EEF0F4, Dark=#2B3346}" StrokeThickness="0"><Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape></Border>
                                    <Grid ColumnDefinitions="39*,61*"><Border Grid.Column="0" BackgroundColor="#2FBF8F" StrokeThickness="0"><Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape></Border></Grid>
                                </Grid>
                                <Label Grid.Column="2" Text="{Binding Aging0Text}" FontSize="12" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" VerticalOptions="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="{loc:Translate Aging31_60}" FontSize="10" TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                                <Grid Grid.Column="1" HeightRequest="8" VerticalOptions="Center">
                                    <Border BackgroundColor="{AppThemeBinding Light=#EEF0F4, Dark=#2B3346}" StrokeThickness="0"><Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape></Border>
                                    <Grid ColumnDefinitions="99*,1*"><Border Grid.Column="0" BackgroundColor="#F2C94C" StrokeThickness="0"><Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape></Border></Grid>
                                </Grid>
                                <Label Grid.Column="2" Text="{Binding Aging1Text}" FontSize="12" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" VerticalOptions="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="{loc:Translate Aging90Plus}" FontSize="10" TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                                <Grid Grid.Column="1" HeightRequest="8" VerticalOptions="Center">
                                    <Border BackgroundColor="{AppThemeBinding Light=#EEF0F4, Dark=#2B3346}" StrokeThickness="0"><Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape></Border>
                                    <Grid ColumnDefinitions="36*,64*"><Border Grid.Column="0" BackgroundColor="#E76A78" StrokeThickness="0"><Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape></Border></Grid>
                                </Grid>
                                <Label Grid.Column="2" Text="{Binding Aging2Text}" FontSize="12" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EEE, Dark=#2E2942}" Margin="0,2" />

                            <!-- Clients (dynamique) -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ClientsLines}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                            <Label Grid.Column="0" Text="{Binding Name}" FontSize="13" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" VerticalOptions="Center" />
                                            <Border Grid.Column="1" BackgroundColor="{Binding BadgeBg}" StrokeThickness="0" Padding="6,2" VerticalOptions="Center">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                <Label Text="{Binding BadgeText}" FontSize="9" FontAttributes="Bold" TextColor="{Binding BadgeFg}" />
                                            </Border>
                                            <Label Grid.Column="2" Text="{Binding AmountText}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" VerticalOptions="Center" WidthRequest="90" HorizontalTextAlignment="End" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Alerte retard -->
                            <Border BackgroundColor="{AppThemeBinding Light=#FDECEC, Dark=#2C1E1E}" StrokeThickness="0" Padding="10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="&#9888;" FontSize="11" TextColor="#C0392B" VerticalOptions="Center" />
                                    <Label Text="{loc:Translate ComptesOverdueAlert}" FontSize="11" TextColor="#C0392B" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Comptes fournisseurs -->
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{loc:Translate AccountsPayableTitle}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding TotalFournisseursText}" FontSize="15" FontAttributes="Bold" TextColor="#C0392B" VerticalOptions="Center" />
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding FournisseursLines}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                                                <Label Text="{Binding DueText}" FontSize="10" TextColor="{StaticResource Gray400}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding AmountText}" FontSize="13" FontAttributes="Bold" TextColor="#C0392B" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Border BackgroundColor="{AppThemeBinding Light=#E7F7EF, Dark=#16281F}" StrokeThickness="0" Padding="10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="&#10003;" FontSize="11" TextColor="#1E8449" VerticalOptions="Center" />
                                    <Label Text="{loc:Translate VendorsUpToDate}" FontSize="11" TextColor="#1E8449" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Ce que ça veut dire -->
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{loc:Translate WhatItMeans}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="•" FontSize="12" TextColor="{StaticResource Gray500}" />
                                <Label Text="{loc:Translate ComptesMeaning1}" FontSize="12" TextColor="{StaticResource Gray500}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="•" FontSize="12" TextColor="{StaticResource Gray500}" />
                                <Label Text="{loc:Translate ComptesMeaning2}" FontSize="12" TextColor="{StaticResource Gray500}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ===== Autres sections (placeholder) ===== -->
                <Border x:Name="OtherSection" IsVisible="False"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Label x:Name="OtherSectionLabel"
                           Text="{loc:Translate SectionUnderConstruction}"
                           FontSize="13"
                           TextColor="{StaticResource Gray400}"
                           HorizontalTextAlignment="Center"
                           Margin="0,20" />
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
