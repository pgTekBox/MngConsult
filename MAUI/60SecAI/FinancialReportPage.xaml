<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:_60SecAI.Controls"
             xmlns:loc="clr-namespace:_60SecAI.Localization"
             x:Class="_60SecAI.FinancialReportPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F2F0FB, Dark=#141221}">

    <Grid RowDefinitions="Auto,*">

        <!-- Menu commun (haut) -->
        <controls:TopMenuView Grid.Row="0"
                              PageTitle="{loc:Translate ReportTitle}"
                              Subtitle="{loc:Translate RealtimeSubtitle}"
                              Balance="48320.55" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16"
                                 Spacing="16">

                <!-- ===== En-tête : titre + périodes + export ===== -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}"
                        StrokeThickness="0"
                        Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10">
                            <Border Grid.Column="0"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    BackgroundColor="#17A672"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>
                                <Label Text="&#128202;"
                                       FontSize="18"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="1"
                                                 VerticalOptions="Center">
                                <Label Text="{loc:Translate ReportTitle}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{loc:Translate WorkerType}"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray400}"
                                           VerticalTextAlignment="Center" />
                                    <Border BackgroundColor="#E7F7EF"
                                            StrokeThickness="0"
                                            Padding="6,2"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="7" />
                                        </Border.StrokeShape>
                                        <Label Text="{loc:Translate UpdatedRealtime}"
                                               FontSize="9"
                                               FontAttributes="Bold"
                                               TextColor="#1E8449" />
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Périodes + actions -->
                        <ScrollView Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8">
                                <Border x:Name="PeriodMois" BackgroundColor="{AppThemeBinding Light=#EEF0F4, Dark=#262138}" StrokeThickness="0" Padding="14,8">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPeriodTapped" CommandParameter="Ce mois" /></Border.GestureRecognizers>
                                    <Label x:Name="PeriodMoisLabel" Text="{loc:Translate PeriodMonth}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                                </Border>
                                <Border x:Name="PeriodTrim" BackgroundColor="Transparent" StrokeThickness="0" Padding="14,8">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPeriodTapped" CommandParameter="Trimestre" /></Border.GestureRecognizers>
                                    <Label x:Name="PeriodTrimLabel" Text="{loc:Translate PeriodQuarter}" FontSize="12" TextColor="{StaticResource Gray500}" />
                                </Border>
                                <Border x:Name="PeriodAnnee" BackgroundColor="Transparent" StrokeThickness="0" Padding="14,8">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPeriodTapped" CommandParameter="Année" /></Border.GestureRecognizers>
                                    <Label x:Name="PeriodAnneeLabel" Text="{loc:Translate PeriodYear}" FontSize="12" TextColor="{StaticResource Gray500}" />
                                </Border>
                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#262138}" Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="14,8">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Label Text="{loc:Translate DetailedView}" FontSize="12" TextColor="{StaticResource Gray600}" />
                                </Border>
                                <Border BackgroundColor="#1F2430" StrokeThickness="0" Padding="14,8">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnExportTapped" /></Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="&#11015;" FontSize="11" TextColor="White" VerticalTextAlignment="Center" />
                                        <Label Text="{loc:Translate Export}" FontSize="12" FontAttributes="Bold" TextColor="White" VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </HorizontalStackLayout>
                        </ScrollView>

                        <!-- Onglets -->
                        <ScrollView Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="6">
                                <Border x:Name="TabApercu" BackgroundColor="#3B5BDB" StrokeThickness="0" Padding="12,7">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Aperçu" /></Border.GestureRecognizers>
                                    <Label x:Name="TabApercuLabel" Text="{loc:Translate TabApercu}" FontSize="12" FontAttributes="Bold" TextColor="White" />
                                </Border>
                                <Border x:Name="TabResultats" BackgroundColor="Transparent" StrokeThickness="0" Padding="12,7">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Résultats" /></Border.GestureRecognizers>
                                    <Label x:Name="TabResultatsLabel" Text="{loc:Translate TabResultats}" FontSize="12" TextColor="{StaticResource Gray500}" />
                                </Border>
                                <Border x:Name="TabBilan" BackgroundColor="Transparent" StrokeThickness="0" Padding="12,7">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Bilan" /></Border.GestureRecognizers>
                                    <Label x:Name="TabBilanLabel" Text="{loc:Translate TabBilan}" FontSize="12" TextColor="{StaticResource Gray500}" />
                                </Border>
                                <Border x:Name="TabTresorerie" BackgroundColor="Transparent" StrokeThickness="0" Padding="12,7">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Trésorerie" /></Border.GestureRecognizers>
                                    <Label x:Name="TabTresorerieLabel" Text="{loc:Translate TabTresorerie}" FontSize="12" TextColor="{StaticResource Gray500}" />
                                </Border>
                                <Border x:Name="TabTaxes" BackgroundColor="Transparent" StrokeThickness="0" Padding="12,7">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Taxes" /></Border.GestureRecognizers>
                                    <Label x:Name="TabTaxesLabel" Text="{loc:Translate TabTaxes}" FontSize="12" TextColor="{StaticResource Gray500}" />
                                </Border>
                                <Border x:Name="TabComptes" BackgroundColor="Transparent" StrokeThickness="0" Padding="12,7">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Comptes" /></Border.GestureRecognizers>
                                    <Label x:Name="TabComptesLabel" Text="{loc:Translate TabComptes}" FontSize="12" TextColor="{StaticResource Gray500}" />
                                </Border>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <!-- ============================================================ -->
                <!-- ===== Section : Aperçu ===== -->
                <!-- ============================================================ -->
                <VerticalStackLayout x:Name="ApercuSection" Spacing="16">

                <!-- ===== Bannière période ===== -->
                <Border BackgroundColor="{AppThemeBinding Light=#EAF1FB, Dark=#1B2740}"
                        StrokeThickness="0"
                        Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="&#8505;" FontSize="14" TextColor="#2D6CDF" VerticalOptions="Start" />
                        <Label FontSize="12"
                               TextColor="{AppThemeBinding Light=#2C3E60, Dark=#C9D4FA}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{loc:Translate BannerPeriodPrefix}" FontAttributes="Bold" />
                                    <Span Text="Juin 2026. " FontAttributes="Bold" />
                                    <Span Text="{loc:Translate ApercuBannerText1}" />
                                    <Span Text="11 960,00 $" />
                                    <Span Text="{loc:Translate ApercuBannerText2}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </HorizontalStackLayout>
                </Border>

                <!-- ===== KPIs principaux ===== -->
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="12">
                    <controls:KpiCard Grid.Row="0" Grid.Column="0"
                                      Title="{loc:Translate KpiRevenue}" Value="{Binding RevenusText}"
                                      Icon="&#128200;" IconBg="#17A672"
                                      Delta="{loc:Translate DeltaRevenue}" Health="{loc:Translate HealthGood}" HealthKind="good" />
                    <controls:KpiCard Grid.Row="0" Grid.Column="1"
                                      Title="{loc:Translate KpiExpenses}" Value="{Binding DepensesText}"
                                      Icon="&#128201;" IconBg="#E23B3B"
                                      Health="{loc:Translate HealthGood}" HealthKind="good" />
                    <controls:KpiCard Grid.Row="1" Grid.Column="0"
                                      Title="{loc:Translate KpiNetProfit}" Value="{Binding BeneficeNetText}"
                                      Icon="&#128176;" IconBg="#3B5BDB"
                                      Delta="{loc:Translate DeltaProfit}" Health="{loc:Translate HealthGood}" HealthKind="good" />
                    <controls:KpiCard Grid.Row="1" Grid.Column="1"
                                      Title="{loc:Translate KpiGrossMargin}" Value="{Binding MargeBrutePctText}"
                                      Icon="&#128196;" IconBg="#7C4DD6"
                                      Subtitle="{loc:Translate KpiGrossMarginSub}" Health="{loc:Translate HealthGood}" HealthKind="good" />
                </Grid>

                <!-- ===== KPIs secondaires ===== -->
                <Grid ColumnDefinitions="*,*,*"
                      ColumnSpacing="10">
                    <controls:KpiCard Grid.Column="0"
                                      Title="{loc:Translate KpiCash}" Value="{Binding TresorerieText}"
                                      Subtitle="{loc:Translate KpiCashSub}" Health="{loc:Translate HealthGood}" HealthKind="good" />
                    <controls:KpiCard Grid.Column="1"
                                      Title="{loc:Translate KpiReceivable}" Value="{Binding ARecevoirText}"
                                      Subtitle="{loc:Translate KpiReceivableSub}" Health="{loc:Translate HealthWatch}" HealthKind="watch" />
                    <controls:KpiCard Grid.Column="2"
                                      Title="{loc:Translate KpiTaxesDue}" Value="2 096,00 $"
                                      Subtitle="{loc:Translate KpiTaxesDueSub}" Health="{loc:Translate HealthAlert}" HealthKind="alert" />
                </Grid>

                <!-- ===== Graphique ===== -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{loc:Translate ChartTitle}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />

                        <!-- Barres -->
                        <Grid ColumnDefinitions="*,*,*"
                              HeightRequest="160"
                              ColumnSpacing="24"
                              Padding="10,0">
                            <Border Grid.Column="0" BackgroundColor="#17A672" StrokeThickness="0" HeightRequest="150" VerticalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8,8,0,0" /></Border.StrokeShape>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="#E23B3B" StrokeThickness="0" HeightRequest="15" VerticalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8,8,0,0" /></Border.StrokeShape>
                            </Border>
                            <Border Grid.Column="2" BackgroundColor="#3B5BDB" StrokeThickness="0" HeightRequest="135" VerticalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8,8,0,0" /></Border.StrokeShape>
                            </Border>
                        </Grid>

                        <!-- Légende -->
                        <Grid ColumnDefinitions="*,*,*"
                              ColumnSpacing="24"
                              Padding="10,0">
                            <VerticalStackLayout Grid.Column="0" Spacing="1" HorizontalOptions="Center">
                                <Label Text="{loc:Translate ChartRevenue}" FontSize="10" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="Center" />
                                <Label Text="13 300 $" FontSize="11" FontAttributes="Bold" TextColor="#17A672" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="Center">
                                <Label Text="{loc:Translate ChartExpenses}" FontSize="10" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="Center" />
                                <Label Text="1 340 $" FontSize="11" FontAttributes="Bold" TextColor="#E23B3B" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="1" HorizontalOptions="Center">
                                <Label Text="{loc:Translate ChartProfit}" FontSize="10" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="Center" />
                                <Label Text="11 960 $" FontSize="11" FontAttributes="Bold" TextColor="#3B5BDB" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                </VerticalStackLayout>
                <!-- fin section Aperçu -->

                <!-- ============================================================ -->
                <!-- ===== Section : Résultats ===== -->
                <!-- ============================================================ -->
                <VerticalStackLayout x:Name="ResultatsSection" IsVisible="False" Spacing="16">

                    <!-- Bannière -->
                    <Border BackgroundColor="{AppThemeBinding Light=#EAF1FB, Dark=#1B2740}"
                            StrokeThickness="0"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="&#8505;" FontSize="14" TextColor="#2D6CDF" VerticalOptions="Start" />
                            <Label FontSize="12"
                                   TextColor="{AppThemeBinding Light=#2C3E60, Dark=#C9D4FA}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{loc:Translate ResBannerPrefix}" FontAttributes="Bold" />
                                        <Span Text="Juin 2026. " FontAttributes="Bold" />
                                        <Span Text="{loc:Translate ResBannerText1}" />
                                        <Span Text="13 300,00 $" FontAttributes="Bold" />
                                        <Span Text="{loc:Translate ResBannerText2}" />
                                        <Span Text="1 340,00 $" FontAttributes="Bold" />
                                        <Span Text="{loc:Translate ResBannerText3}" />
                                        <Span Text="11 960,00 $" FontAttributes="Bold" />
                                        <Span Text="{loc:Translate ResBannerText4}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- 3 cartes -->
                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="10">

                        <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#E7F7EF, Dark=#16281F}" StrokeThickness="0" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{loc:Translate KpiRevenue}" FontSize="10" FontAttributes="Bold" TextColor="#1E8449" />
                                <Label Text="{Binding RevenusText}" FontSize="17" FontAttributes="Bold" TextColor="#1E8449" />
                                <Label Text="{loc:Translate ResRevenueDelta}" FontSize="9" TextColor="#1E8449" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#FDECEC, Dark=#2C1E1E}" StrokeThickness="0" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{loc:Translate KpiExpenses}" FontSize="10" FontAttributes="Bold" TextColor="#C0392B" />
                                <Label Text="{Binding DepensesText}" FontSize="17" FontAttributes="Bold" TextColor="#C0392B" />
                                <Label Text="{loc:Translate ResExpenseDelta}" FontSize="9" TextColor="#C0392B" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light=#EAF1FB, Dark=#1B2740}" StrokeThickness="0" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{loc:Translate KpiNetProfit}" FontSize="10" FontAttributes="Bold" TextColor="#2D6CDF" />
                                <Label Text="{Binding BeneficeNetText}" FontSize="17" FontAttributes="Bold" TextColor="#2D6CDF" />
                                <Label Text="{loc:Translate ResProfitDelta}" FontSize="9" TextColor="#2D6CDF" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Marge brute -->
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{loc:Translate GrossMargin}" FontSize="14" FontAttributes="Bold" TextColor="#2D6CDF" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding BeneficeBrutText}" FontSize="16" FontAttributes="Bold" TextColor="#2D6CDF" VerticalOptions="Center" />
                            </Grid>
                            <Grid HeightRequest="10">
                                <Border BackgroundColor="{AppThemeBinding Light=#E4E7EF, Dark=#2B3346}" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="5" /></Border.StrokeShape>
                                </Border>
                                <Grid ColumnDefinitions="899*,101*">
                                    <Border Grid.Column="0" BackgroundColor="#3B5BDB" StrokeThickness="0">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="5" /></Border.StrokeShape>
                                    </Border>
                                </Grid>
                            </Grid>
                            <Label Text="{loc:Translate GrossMarginOfRevenue}" FontSize="11" TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Ce que ça veut dire -->
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{loc:Translate WhatItMeans}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="•" FontSize="12" TextColor="{StaticResource Gray500}" />
                                <Label Text="{loc:Translate ResMeaning1}" FontSize="12" TextColor="{StaticResource Gray500}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="•" FontSize="12" TextColor="{StaticResource Gray500}" />
                                <Label Text="{loc:Translate ResMeaning2}" FontSize="12" TextColor="{StaticResource Gray500}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ============================================================ -->
                <!-- ===== Section : Bilan ===== -->
                <!-- ============================================================ -->
                <VerticalStackLayout x:Name="BilanSection" IsVisible="False" Spacing="16">

                    <!-- Bannière -->
                    <Border BackgroundColor="{AppThemeBinding Light=#EAF1FB, Dark=#1B2740}" StrokeThickness="0" Padding="14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="&#8505;" FontSize="14" TextColor="#2D6CDF" VerticalOptions="Start" />
                            <Label FontSize="12" TextColor="{AppThemeBinding Light=#2C3E60, Dark=#C9D4FA}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{loc:Translate BilanBannerPrefix}" FontAttributes="Bold" />
                                        <Span Text="17 juin 2026. " FontAttributes="Bold" />
                                        <Span Text="{loc:Translate BilanBannerText1}" />
                                        <Span Text="{Binding TotalActifsText}" FontAttributes="Bold" />
                                        <Span Text="{loc:Translate BilanBannerText2}" />
                                        <Span Text="{Binding TotalPassifsText}" FontAttributes="Bold" />
                                        <Span Text="{loc:Translate BilanBannerText3}" />
                                        <Span Text="{Binding ValeurNetteText}" FontAttributes="Bold" />
                                        <Span Text="." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Équation comptable -->
                    <Border BackgroundColor="{AppThemeBinding Light=#F4F5F8, Dark=#1B2233}" StrokeThickness="0" Padding="14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{loc:Translate AccountingEquation}" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource Gray400}" />

                            <Grid ColumnDefinitions="*,Auto,*,Auto,*" ColumnSpacing="4">
                                <VerticalStackLayout Grid.Column="0" Spacing="1" HorizontalOptions="Center">
                                    <Label Text="{Binding TotalActifsText}" FontSize="14" FontAttributes="Bold" TextColor="#2D6CDF" HorizontalTextAlignment="Center" />
                                    <Label Text="{loc:Translate Assets}" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="Center" />
                                    <Label Text="{loc:Translate WhatYouOwn}" FontSize="8" TextColor="{StaticResource Gray400}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="=" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Gray500}" VerticalOptions="Start" Margin="0,2,0,0" />
                                <VerticalStackLayout Grid.Column="2" Spacing="1" HorizontalOptions="Center">
                                    <Label Text="{Binding TotalPassifsText}" FontSize="14" FontAttributes="Bold" TextColor="#E23B3B" HorizontalTextAlignment="Center" />
                                    <Label Text="{loc:Translate Liabilities}" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="Center" />
                                    <Label Text="{loc:Translate WhatYouOwe}" FontSize="8" TextColor="{StaticResource Gray400}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                                <Label Grid.Column="3" Text="+" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Gray500}" VerticalOptions="Start" Margin="0,2,0,0" />
                                <VerticalStackLayout Grid.Column="4" Spacing="1" HorizontalOptions="Center">
                                    <Label Text="{Binding ValeurNetteText}" FontSize="14" FontAttributes="Bold" TextColor="#1E8449" HorizontalTextAlignment="Center" />
                                    <Label Text="{loc:Translate NetWorth}" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="Center" />
                                    <Label Text="{loc:Translate WhatIsYours}" FontSize="8" TextColor="{StaticResource Gray400}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Barre passifs / valeur nette -->
                            <Grid ColumnDefinitions="19*,81*" HeightRequest="12">
                                <Border Grid.Column="0" BackgroundColor="#E76A78" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="6,0,0,6" /></Border.StrokeShape>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="#2FBF8F" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="0,6,6,0" /></Border.StrokeShape>
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,*">
                                <Label Grid.Column="0" Text="{Binding PassifsPctText}" FontSize="10" TextColor="{StaticResource Gray400}" HorizontalOptions="Start" />
                                <Label Grid.Column="1" Text="{Binding ValeurNettePctText}" FontSize="10" TextColor="{StaticResource Gray400}" HorizontalOptions="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Actifs -->
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">

                            <Label Text="{loc:Translate AssetsTitle}" FontSize="15" FontAttributes="Bold" TextColor="#2D6CDF" />

                            <!-- Actifs courants -->
                            <Label Text="{loc:Translate CurrentAssets}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" Margin="0,4,0,0" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ActifsCourantsLines}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto" Padding="12,0,0,0">
                                            <Label Grid.Column="0" Text="{Binding Description}" FontSize="12" TextColor="{StaticResource Gray500}" />
                                            <Label Grid.Column="1" Text="{Binding AmountText}" FontSize="12" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
