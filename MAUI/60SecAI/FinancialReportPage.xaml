<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:_60SecAI.Controls"
             x:Class="_60SecAI.FinancialReportPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F2F0FB, Dark=#141221}">

    <Grid RowDefinitions="Auto,*">

        <!-- Menu commun (haut) -->
        <controls:TopMenuView Grid.Row="0"
                              PageTitle="Rapports financiers"
                              Subtitle="Gestion en temps réel avec AI"
                              Balance="48320.55" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16"
                                 Spacing="16">

                <!-- ===== En-tête : titre + périodes + export ===== -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}"
                        StrokeThickness="0"
                        Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10">
                            <Border Grid.Column="0"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    BackgroundColor="#17A672"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>
                                <Label Text="&#128202;"
                                       FontSize="18"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="1"
                                                 VerticalOptions="Center">
                                <Label Text="Rapports financiers"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="Travailleur autonome"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray400}"
                                           VerticalTextAlignment="Center" />
                                    <Border BackgroundColor="#E7F7EF"
                                            StrokeThickness="0"
                                            Padding="6,2"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="7" />
                                        </Border.StrokeShape>
                                        <Label Text="Mis à jour en temps réel"
                                               FontSize="9"
                                               FontAttributes="Bold"
                                               TextColor="#1E8449" />
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Périodes + actions -->
                        <ScrollView Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8">
                                <Border x:Name="PeriodMois" BackgroundColor="{AppThemeBinding Light=#EEF0F4, Dark=#262138}" StrokeThickness="0" Padding="14,8">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPeriodTapped" CommandParameter="Ce mois" /></Border.GestureRecognizers>
                                    <Label x:Name="PeriodMoisLabel" Text="Ce mois" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                                </Border>
                                <Border x:Name="PeriodTrim" BackgroundColor="Transparent" StrokeThickness="0" Padding="14,8">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPeriodTapped" CommandParameter="Trimestre" /></Border.GestureRecognizers>
                                    <Label x:Name="PeriodTrimLabel" Text="Trimestre" FontSize="12" TextColor="{StaticResource Gray500}" />
                                </Border>
                                <Border x:Name="PeriodAnnee" BackgroundColor="Transparent" StrokeThickness="0" Padding="14,8">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPeriodTapped" CommandParameter="Année" /></Border.GestureRecognizers>
                                    <Label x:Name="PeriodAnneeLabel" Text="Année" FontSize="12" TextColor="{StaticResource Gray500}" />
                                </Border>
                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#262138}" Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="14,8">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Label Text="Vue détaillée" FontSize="12" TextColor="{StaticResource Gray600}" />
                                </Border>
                                <Border BackgroundColor="#1F2430" StrokeThickness="0" Padding="14,8">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnExportTapped" /></Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="&#11015;" FontSize="11" TextColor="White" VerticalTextAlignment="Center" />
                                        <Label Text="Exporter" FontSize="12" FontAttributes="Bold" TextColor="White" VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </HorizontalStackLayout>
                        </ScrollView>

                        <!-- Onglets -->
                        <ScrollView Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="6">
                                <Border x:Name="TabApercu" BackgroundColor="#3B5BDB" StrokeThickness="0" Padding="12,7">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Aperçu" /></Border.GestureRecognizers>
                                    <Label x:Name="TabApercuLabel" Text="Aperçu" FontSize="12" FontAttributes="Bold" TextColor="White" />
                                </Border>
                                <Border x:Name="TabResultats" BackgroundColor="Transparent" StrokeThickness="0" Padding="12,7">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Résultats" /></Border.GestureRecognizers>
                                    <Label x:Name="TabResultatsLabel" Text="Résultats" FontSize="12" TextColor="{StaticResource Gray500}" />
                                </Border>
                                <Border x:Name="TabBilan" BackgroundColor="Transparent" StrokeThickness="0" Padding="12,7">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Bilan" /></Border.GestureRecognizers>
                                    <Label x:Name="TabBilanLabel" Text="Bilan" FontSize="12" TextColor="{StaticResource Gray500}" />
                                </Border>
                                <Border x:Name="TabTresorerie" BackgroundColor="Transparent" StrokeThickness="0" Padding="12,7">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Trésorerie" /></Border.GestureRecognizers>
                                    <Label x:Name="TabTresorerieLabel" Text="Trésorerie" FontSize="12" TextColor="{StaticResource Gray500}" />
                                </Border>
                                <Border x:Name="TabTaxes" BackgroundColor="Transparent" StrokeThickness="0" Padding="12,7">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Taxes" /></Border.GestureRecognizers>
                                    <Label x:Name="TabTaxesLabel" Text="Taxes" FontSize="12" TextColor="{StaticResource Gray500}" />
                                </Border>
                                <Border x:Name="TabComptes" BackgroundColor="Transparent" StrokeThickness="0" Padding="12,7">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Comptes" /></Border.GestureRecognizers>
                                    <Label x:Name="TabComptesLabel" Text="Comptes" FontSize="12" TextColor="{StaticResource Gray500}" />
                                </Border>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <!-- ============================================================ -->
                <!-- ===== Section : Aperçu ===== -->
                <!-- ============================================================ -->
                <VerticalStackLayout x:Name="ApercuSection" Spacing="16">

                <!-- ===== Bannière période ===== -->
                <Border BackgroundColor="{AppThemeBinding Light=#EAF1FB, Dark=#1B2740}"
                        StrokeThickness="0"
                        Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="&#8505;" FontSize="14" TextColor="#2D6CDF" VerticalOptions="Start" />
                        <Label FontSize="12"
                               TextColor="{AppThemeBinding Light=#2C3E60, Dark=#C9D4FA}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Période : Juin 2026. " FontAttributes="Bold" />
                                    <Span Text="Votre entreprise est rentable : vous avez gagné 11 960,00 $ de plus que vos dépenses. C'est une bonne nouvelle !" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </HorizontalStackLayout>
                </Border>

                <!-- ===== KPIs principaux ===== -->
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="12">
                    <controls:KpiCard Grid.Row="0" Grid.Column="0"
                                      Title="REVENUS" Value="13 300,00 $"
                                      Icon="&#128200;" IconBg="#17A672"
                                      Delta="↗ +13.6 % vs période préc." Health="Sain" HealthKind="good" />
                    <controls:KpiCard Grid.Row="0" Grid.Column="1"
                                      Title="DÉPENSES" Value="1 340,00 $"
                                      Icon="&#128201;" IconBg="#E23B3B"
                                      Health="Sain" HealthKind="good" />
                    <controls:KpiCard Grid.Row="1" Grid.Column="0"
                                      Title="BÉNÉFICE NET" Value="11 960,00 $"
                                      Icon="&#128176;" IconBg="#3B5BDB"
                                      Delta="↗ +16.3 % vs période préc." Health="Sain" HealthKind="good" />
                    <controls:KpiCard Grid.Row="1" Grid.Column="1"
                                      Title="MARGE BRUTE" Value="89.9 %"
                                      Icon="&#128196;" IconBg="#7C4DD6"
                                      Subtitle="Revenus − dépenses directes" Health="Sain" HealthKind="good" />
                </Grid>

                <!-- ===== KPIs secondaires ===== -->
                <Grid ColumnDefinitions="*,*,*"
                      ColumnSpacing="10">
                    <controls:KpiCard Grid.Column="0"
                                      Title="TRÉSORERIE" Value="28 450,00 $"
                                      Subtitle="Solde bancaire professionnel" Health="Sain" HealthKind="good" />
                    <controls:KpiCard Grid.Column="1"
                                      Title="À RECEVOIR DES CLIENTS" Value="18 700,00 $"
                                      Subtitle="Dont 3 800 $ en retard (+90 j)" Health="À surveiller" HealthKind="watch" />
                    <controls:KpiCard Grid.Column="2"
                                      Title="TAXES À REMETTRE" Value="2 096,00 $"
                                      Subtitle="Prochaine échéance : 31 juil. 2026" Health="Attention" HealthKind="alert" />
                </Grid>

                <!-- ===== Graphique ===== -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Revenus vs Dépenses — Juin 2026"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />

                        <!-- Barres -->
                        <Grid ColumnDefinitions="*,*,*"
                              HeightRequest="160"
                              ColumnSpacing="24"
                              Padding="10,0">
                            <Border Grid.Column="0" BackgroundColor="#17A672" StrokeThickness="0" HeightRequest="150" VerticalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8,8,0,0" /></Border.StrokeShape>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="#E23B3B" StrokeThickness="0" HeightRequest="15" VerticalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8,8,0,0" /></Border.StrokeShape>
                            </Border>
                            <Border Grid.Column="2" BackgroundColor="#3B5BDB" StrokeThickness="0" HeightRequest="135" VerticalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8,8,0,0" /></Border.StrokeShape>
                            </Border>
                        </Grid>

                        <!-- Légende -->
                        <Grid ColumnDefinitions="*,*,*"
                              ColumnSpacing="24"
                              Padding="10,0">
                            <VerticalStackLayout Grid.Column="0" Spacing="1" HorizontalOptions="Center">
                                <Label Text="Revenus" FontSize="10" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="Center" />
                                <Label Text="13 300 $" FontSize="11" FontAttributes="Bold" TextColor="#17A672" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="Center">
                                <Label Text="Dépenses" FontSize="10" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="Center" />
                                <Label Text="1 340 $" FontSize="11" FontAttributes="Bold" TextColor="#E23B3B" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="1" HorizontalOptions="Center">
                                <Label Text="Bénéfice" FontSize="10" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="Center" />
                                <Label Text="11 960 $" FontSize="11" FontAttributes="Bold" TextColor="#3B5BDB" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                </VerticalStackLayout>
                <!-- fin section Aperçu -->

                <!-- ============================================================ -->
                <!-- ===== Section : Résultats ===== -->
                <!-- ============================================================ -->
                <VerticalStackLayout x:Name="ResultatsSection" IsVisible="False" Spacing="16">

                    <!-- Bannière -->
                    <Border BackgroundColor="{AppThemeBinding Light=#EAF1FB, Dark=#1B2740}"
                            StrokeThickness="0"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="&#8505;" FontSize="14" TextColor="#2D6CDF" VerticalOptions="Start" />
                            <Label FontSize="12"
                                   TextColor="{AppThemeBinding Light=#2C3E60, Dark=#C9D4FA}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Revenus et dépenses — Juin 2026. " FontAttributes="Bold" />
                                        <Span Text="Vos revenus s'élèvent à " />
                                        <Span Text="13 300,00 $" FontAttributes="Bold" />
                                        <Span Text=" et vos dépenses déductibles à " />
                                        <Span Text="1 340,00 $" FontAttributes="Bold" />
                                        <Span Text=", pour un bénéfice net de " />
                                        <Span Text="11 960,00 $" FontAttributes="Bold" />
                                        <Span Text=". C'est +16.3 % de plus que la période précédente." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- 3 cartes -->
                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="10">

                        <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#E7F7EF, Dark=#16281F}" StrokeThickness="0" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="REVENUS" FontSize="10" FontAttributes="Bold" TextColor="#1E8449" />
                                <Label Text="13 300,00 $" FontSize="17" FontAttributes="Bold" TextColor="#1E8449" />
                                <Label Text="↗ 13.6 % vs période préc." FontSize="9" TextColor="#1E8449" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#FDECEC, Dark=#2C1E1E}" StrokeThickness="0" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="DÉPENSES" FontSize="10" FontAttributes="Bold" TextColor="#C0392B" />
                                <Label Text="1 340,00 $" FontSize="17" FontAttributes="Bold" TextColor="#C0392B" />
                                <Label Text="↗ 7.5 % vs période préc." FontSize="9" TextColor="#C0392B" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light=#EAF1FB, Dark=#1B2740}" StrokeThickness="0" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="BÉNÉFICE NET" FontSize="10" FontAttributes="Bold" TextColor="#2D6CDF" />
                                <Label Text="11 960,00 $" FontSize="17" FontAttributes="Bold" TextColor="#2D6CDF" />
                                <Label Text="↗ 16.3 % vs période préc." FontSize="9" TextColor="#2D6CDF" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Marge brute -->
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Marge brute" FontSize="14" FontAttributes="Bold" TextColor="#2D6CDF" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="11 960,00 $" FontSize="16" FontAttributes="Bold" TextColor="#2D6CDF" VerticalOptions="Center" />
                            </Grid>
                            <Grid HeightRequest="10">
                                <Border BackgroundColor="{AppThemeBinding Light=#E4E7EF, Dark=#2B3346}" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="5" /></Border.StrokeShape>
                                </Border>
                                <Grid ColumnDefinitions="899*,101*">
                                    <Border Grid.Column="0" BackgroundColor="#3B5BDB" StrokeThickness="0">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="5" /></Border.StrokeShape>
                                    </Border>
                                </Grid>
                            </Grid>
                            <Label Text="89.9 % de vos revenus" FontSize="11" TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Ce que ça veut dire -->
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Ce que ça veut dire pour vous" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="•" FontSize="12" TextColor="{StaticResource Gray500}" />
                                <Label Text="Vos dépenses représentent 10.1 % de vos revenus — c'est excellent." FontSize="12" TextColor="{StaticResource Gray500}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="•" FontSize="12" TextColor="{StaticResource Gray500}" />
                                <Label Text="Le rapport peut être partagé avec votre comptable pour votre déclaration annuelle." FontSize="12" TextColor="{StaticResource Gray500}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ============================================================ -->
                <!-- ===== Section : Bilan ===== -->
                <!-- ============================================================ -->
                <VerticalStackLayout x:Name="BilanSection" IsVisible="False" Spacing="16">

                    <!-- Bannière -->
                    <Border BackgroundColor="{AppThemeBinding Light=#EAF1FB, Dark=#1B2740}" StrokeThickness="0" Padding="14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="&#8505;" FontSize="14" TextColor="#2D6CDF" VerticalOptions="Start" />
                            <Label FontSize="12" TextColor="{AppThemeBinding Light=#2C3E60, Dark=#C9D4FA}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Bilan au 17 juin 2026. " FontAttributes="Bold" />
                                        <Span Text="Votre entreprise possède " />
                                        <Span Text="55 950,00 $" FontAttributes="Bold" />
                                        <Span Text=" en actifs, doit " />
                                        <Span Text="10 646,00 $" FontAttributes="Bold" />
                                        <Span Text=" en passifs et votre valeur nette est de " />
                                        <Span Text="45 304,00 $" FontAttributes="Bold" />
                                        <Span Text="." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Équation comptable -->
                    <Border BackgroundColor="{AppThemeBinding Light=#F4F5F8, Dark=#1B2233}" StrokeThickness="0" Padding="14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="L'ÉQUATION COMPTABLE FONDAMENTALE" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource Gray400}" />

                            <Grid ColumnDefinitions="*,Auto,*,Auto,*" ColumnSpacing="4">
                                <VerticalStackLayout Grid.Column="0" Spacing="1" HorizontalOptions="Center">
                                    <Label Text="55 950,00 $" FontSize="14" FontAttributes="Bold" TextColor="#2D6CDF" HorizontalTextAlignment="Center" />
                                    <Label Text="ACTIFS" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="Center" />
                                    <Label Text="Ce que vous possédez" FontSize="8" TextColor="{StaticResource Gray400}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="=" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Gray500}" VerticalOptions="Start" Margin="0,2,0,0" />
                                <VerticalStackLayout Grid.Column="2" Spacing="1" HorizontalOptions="Center">
                                    <Label Text="10 646,00 $" FontSize="14" FontAttributes="Bold" TextColor="#E23B3B" HorizontalTextAlignment="Center" />
                                    <Label Text="PASSIFS" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="Center" />
                                    <Label Text="Ce que vous devez" FontSize="8" TextColor="{StaticResource Gray400}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                                <Label Grid.Column="3" Text="+" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Gray500}" VerticalOptions="Start" Margin="0,2,0,0" />
                                <VerticalStackLayout Grid.Column="4" Spacing="1" HorizontalOptions="Center">
                                    <Label Text="45 304,00 $" FontSize="14" FontAttributes="Bold" TextColor="#1E8449" HorizontalTextAlignment="Center" />
                                    <Label Text="VALEUR NETTE" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="Center" />
                                    <Label Text="Ce qui vous revient" FontSize="8" TextColor="{StaticResource Gray400}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Barre passifs / valeur nette -->
                            <Grid ColumnDefinitions="19*,81*" HeightRequest="12">
                                <Border Grid.Column="0" BackgroundColor="#E76A78" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="6,0,0,6" /></Border.StrokeShape>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="#2FBF8F" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="0,6,6,0" /></Border.StrokeShape>
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,*">
                                <Label Grid.Column="0" Text="Passifs 19 %" FontSize="10" TextColor="{StaticResource Gray400}" HorizontalOptions="Start" />
                                <Label Grid.Column="1" Text="Valeur nette 81 %" FontSize="10" TextColor="{StaticResource Gray400}" HorizontalOptions="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Actifs -->
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">

                            <Label Text="Actifs" FontSize="15" FontAttributes="Bold" TextColor="#2D6CDF" />

                            <!-- Actifs courants -->
                            <Label Text="Actifs courants" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" Margin="0,4,0,0" />
                            <Grid ColumnDefinitions="*,Auto" Padding="12,0,0,0">
                                <Label Grid.Column="0" Text="Compte bancaire" FontSize="12" TextColor="{StaticResource Gray500}" />
                                <Label Grid.Column="1" Text="28 450,00 $" FontSize="12" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Padding="12,0,0,0">
                                <Label Grid.Column="0" Text="Comptes clients" FontSize="12" TextColor="{StaticResource Gray500}" />
                                <Label Grid.Column="1" Text="18 700,00 $" FontSize="12" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Padding="12,0,0,0">
                                <Label Grid.Column="0" Text="Frais payés d'avance" FontSize="12" TextColor="{StaticResource Gray500}" />
                                <Label Grid.Column="1" Text="1 200,00 $" FontSize="12" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
