<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:_60SecAI.Controls"
             xmlns:vm="clr-namespace:_60SecAI.ViewModels"
             x:Class="_60SecAI.AiSalesDetailPage"
             x:DataType="vm:AiSalesDetailViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F2F0FB, Dark=#141221}">

    <Grid RowDefinitions="Auto,*">

        <!-- Menu commun (haut) -->
        <controls:TopMenuView Grid.Row="0"
                              PageTitle="AI Sales"
                              Subtitle="Gestion en temps réel avec AI"
                              Balance="48320.55" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Invoices}">

            <!-- ===== En-tête : titre + onglets ===== -->
            <CollectionView.Header>
                <VerticalStackLayout>

                    <HorizontalStackLayout Spacing="6" Padding="16,16,16,8">
                        <Label Text="Détail —" FontSize="20" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                        <Label Text="{Binding PeriodText}" FontSize="20" FontAttributes="Bold"
                               TextColor="{StaticResource Gray400}" />
                    </HorizontalStackLayout>

                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}"
                            StrokeThickness="0" Padding="16" Margin="16,0,16,8">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6">

                            <Border Grid.Column="0" BackgroundColor="{Binding CollectedTabBg}"
                                    StrokeThickness="0" Padding="12,8">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="collected" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="&#128200;" FontSize="12" TextColor="#1E8449" VerticalTextAlignment="Center" />
                                    <Label Text="Collecté" FontSize="12" FontAttributes="Bold" TextColor="#1E8449" VerticalTextAlignment="Center" />
                                    <Border BackgroundColor="#1E8449" StrokeThickness="0" Padding="6,1" VerticalOptions="Center">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="9" /></Border.StrokeShape>
                                        <Label Text="{Binding CollectedCount}" FontSize="10" FontAttributes="Bold" TextColor="White" />
                                    </Border>
                                </HorizontalStackLayout>
                            </Border>

                            <Border Grid.Column="1" BackgroundColor="{Binding ReceivableTabBg}"
                                    StrokeThickness="0" Padding="12,8">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="receivable" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="&#8599;" FontSize="12" TextColor="{StaticResource Gray500}" VerticalTextAlignment="Center" />
                                    <Label Text="Recev." FontSize="12" TextColor="{StaticResource Gray500}" VerticalTextAlignment="Center" />
                                    <Border BackgroundColor="#E9A100" StrokeThickness="0" Padding="6,1" VerticalOptions="Center">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="9" /></Border.StrokeShape>
                                        <Label Text="{Binding ReceivableCount}" FontSize="10" FontAttributes="Bold" TextColor="White" />
                                    </Border>
                                </HorizontalStackLayout>
                            </Border>

                            <Border Grid.Column="2" BackgroundColor="{Binding OverdueTabBg}"
                                    StrokeThickness="0" Padding="12,8">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="overdue" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="&#9888;" FontSize="12" TextColor="{StaticResource Gray500}" VerticalTextAlignment="Center" />
                                    <Label Text="Retard" FontSize="12" TextColor="{StaticResource Gray500}" VerticalTextAlignment="Center" />
                                    <Border BackgroundColor="#E23B3B" StrokeThickness="0" Padding="6,1" VerticalOptions="Center">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="9" /></Border.StrokeShape>
                                        <Label Text="{Binding OverdueCount}" FontSize="10" FontAttributes="Bold" TextColor="White" />
                                    </Border>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- ===== Facture (item) ===== -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:InvoiceListItem">
                    <Border BackgroundColor="{Binding RowBackground}" StrokeThickness="0"
                            Padding="12" Margin="16,0,16,8">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="{Binding Icon}" FontSize="16"
                                   TextColor="{Binding AmountColor}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{Binding ClientName}" FontSize="14" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                                <Label Text="{Binding Description}" FontSize="11" TextColor="{StaticResource Gray400}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">
                                <Label Text="{Binding DateText}" FontSize="11" TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                                <Label Text="{Binding AmountText}" FontSize="14" FontAttributes="Bold"
                                       TextColor="{Binding AmountColor}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- ===== Liste vide ===== -->
            <CollectionView.EmptyView>
                <Label Text="{Binding EmptyText}" FontSize="13"
                       TextColor="{StaticResource Gray400}"
                       HorizontalTextAlignment="Center" Margin="0,24" />
            </CollectionView.EmptyView>

            <!-- ===== Pied : Période de vente ===== -->
            <CollectionView.Footer>
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}"
                        StrokeThickness="0" Padding="16" Margin="16,8,16,16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">

                        <VerticalStackLayout Spacing="0">
                            <Label Text="Période de vente" FontSize="18" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                            <Label Text="Sélectionnez une période" FontSize="12" TextColor="{StaticResource Gray400}" />
                        </VerticalStackLayout>

                        <Border BackgroundColor="{AppThemeBinding Light=#FEF9E7, Dark=#2A2616}" Stroke="#F2A900" StrokeThickness="1.5" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPeriodCommand}" CommandParameter="Today" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="Today" FontSize="15" FontAttributes="Bold" TextColor="#B9770E" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="6 ventes · 5 240,00 $" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#262138}" Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPeriodCommand}" CommandParameter="Week" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="Week" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="14 ventes · 28 750,00 $" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#262138}" Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPeriodCommand}" CommandParameter="Month" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="Month" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="28 ventes · 141 380,00 $" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#262138}" Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPeriodCommand}" CommandParameter="3 Months" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="3 Months" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="25 ventes · 458 820,00 $" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </CollectionView.Footer>
        </CollectionView>
    </Grid>

</ContentPage>
