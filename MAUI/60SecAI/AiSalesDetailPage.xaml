<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:_60SecAI.Controls"
             xmlns:vm="clr-namespace:_60SecAI.ViewModels"
             xmlns:loc="clr-namespace:_60SecAI.Localization"
             x:Class="_60SecAI.AiSalesDetailPage"
             x:Name="Page"
             x:DataType="vm:AiSalesDetailViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F2F0FB, Dark=#141221}">

    <Grid RowDefinitions="Auto,*">

        <!-- Menu commun (haut) -->
        <controls:TopMenuView Grid.Row="0"
                              PageTitle="AI Sales"
                              Subtitle="{loc:Translate RealtimeSubtitle}"
                              Balance="48320.55"
                              ShowHome="True" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Invoices}">

            <!-- ===== En-tête : titre + onglets ===== -->
            <CollectionView.Header>
                <VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" Padding="16,16,16,8" ColumnSpacing="8" VerticalOptions="Center">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Label Text="{loc:Translate DetailPrefix}" FontSize="20" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                            <Label Text="{Binding PeriodText}" FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource Gray400}" />
                        </HorizontalStackLayout>
                        <Button Grid.Column="1" Text="{loc:Translate NewInvoice}"
                                BackgroundColor="{StaticResource Primary}" TextColor="White"
                                FontSize="13" FontAttributes="Bold" HeightRequest="40"
                                CornerRadius="14" Padding="14,0" VerticalOptions="Center"
                                Clicked="OnNewInvoiceClicked" />
                    </Grid>

                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}"
                            StrokeThickness="0" Padding="16" Margin="16,0,16,8">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                          <HorizontalStackLayout Spacing="6">

                            <Border BackgroundColor="{Binding AllTabBg}"
                                    StrokeThickness="0" Padding="12,8">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="all" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="&#128203;" FontSize="12" TextColor="#2D6CDF" VerticalTextAlignment="Center" />
                                    <Label Text="{loc:Translate TabAll}" FontSize="12" FontAttributes="Bold" TextColor="#2D6CDF" VerticalTextAlignment="Center" />
                                    <Border BackgroundColor="#2D6CDF" StrokeThickness="0" Padding="6,1" VerticalOptions="Center">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="9" /></Border.StrokeShape>
                                        <Label Text="{Binding AllCount}" FontSize="10" FontAttributes="Bold" TextColor="White" />
                                    </Border>
                                </HorizontalStackLayout>
                            </Border>

                            <Border Grid.Column="0" BackgroundColor="{Binding CollectedTabBg}"
                                    StrokeThickness="0" Padding="12,8">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="collected" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="&#128200;" FontSize="12" TextColor="#1E8449" VerticalTextAlignment="Center" />
                                    <Label Text="{loc:Translate TabCollected}" FontSize="12" FontAttributes="Bold" TextColor="#1E8449" VerticalTextAlignment="Center" />
                                    <Border BackgroundColor="#1E8449" StrokeThickness="0" Padding="6,1" VerticalOptions="Center">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="9" /></Border.StrokeShape>
                                        <Label Text="{Binding CollectedCount}" FontSize="10" FontAttributes="Bold" TextColor="White" />
                                    </Border>
                                </HorizontalStackLayout>
                            </Border>

                            <Border Grid.Column="1" BackgroundColor="{Binding ReceivableTabBg}"
                                    StrokeThickness="0" Padding="12,8">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="receivable" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="&#8599;" FontSize="12" TextColor="{StaticResource Gray500}" VerticalTextAlignment="Center" />
                                    <Label Text="{loc:Translate TabReceivable}" FontSize="12" TextColor="{StaticResource Gray500}" VerticalTextAlignment="Center" />
                                    <Border BackgroundColor="#E9A100" StrokeThickness="0" Padding="6,1" VerticalOptions="Center">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="9" /></Border.StrokeShape>
                                        <Label Text="{Binding ReceivableCount}" FontSize="10" FontAttributes="Bold" TextColor="White" />
                                    </Border>
                                </HorizontalStackLayout>
                            </Border>

                            <Border Grid.Column="2" BackgroundColor="{Binding OverdueTabBg}"
                                    StrokeThickness="0" Padding="12,8">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="overdue" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="&#9888;" FontSize="12" TextColor="{StaticResource Gray500}" VerticalTextAlignment="Center" />
                                    <Label Text="{loc:Translate TabOverdue}" FontSize="12" TextColor="{StaticResource Gray500}" VerticalTextAlignment="Center" />
                                    <Border BackgroundColor="#E23B3B" StrokeThickness="0" Padding="6,1" VerticalOptions="Center">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="9" /></Border.StrokeShape>
                                        <Label Text="{Binding OverdueCount}" FontSize="10" FontAttributes="Bold" TextColor="White" />
                                    </Border>
                                </HorizontalStackLayout>
                            </Border>
                          </HorizontalStackLayout>
                        </ScrollView>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- ===== Facture (item) ===== -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:InvoiceListItem">
                    <Border BackgroundColor="{Binding RowBackground}" StrokeThickness="0"
                            Padding="12" Margin="16,0,16,8">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.OpenInvoiceCommand, Source={x:Reference Page}}"
                                                  CommandParameter="{Binding Id}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="{Binding Icon}" FontSize="16"
                                   TextColor="{Binding AmountColor}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{Binding Number}" FontSize="14" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                                <Label Text="{Binding ClientName}" FontSize="11" TextColor="{StaticResource Gray400}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">
                                <Label Text="{Binding DateText}" FontSize="11" TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                                <Label Text="{Binding AmountText}" FontSize="14" FontAttributes="Bold"
                                       TextColor="{Binding AmountColor}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="3" Text="&#8250;" FontSize="18" TextColor="{StaticResource Gray300}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- ===== Liste vide ===== -->
            <CollectionView.EmptyView>
                <Label Text="{Binding EmptyText}" FontSize="13"
                       TextColor="{StaticResource Gray400}"
                       HorizontalTextAlignment="Center" Margin="0,24" />
            </CollectionView.EmptyView>

            <!-- ===== Pied : Période de vente ===== -->
            <CollectionView.Footer>
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}"
                        StrokeThickness="0" Padding="16" Margin="16,8,16,16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">

                        <VerticalStackLayout Spacing="0">
                            <Label Text="{loc:Translate SalesPeriodTitle}" FontSize="18" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                            <Label Text="{loc:Translate SalesPeriodSubtitle}" FontSize="12" TextColor="{StaticResource Gray400}" />
                        </VerticalStackLayout>

                        <Border BackgroundColor="{AppThemeBinding Light=#FEF9E7, Dark=#2A2616}" Stroke="#F2A900" StrokeThickness="1.5" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPeriodCommand}" CommandParameter="Today" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="Today" FontSize="15" FontAttributes="Bold" TextColor="#B9770E" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{loc:Translate PeriodTodaySales}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#262138}" Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPeriodCommand}" CommandParameter="Week" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="Week" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{loc:Translate PeriodWeekSales}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#262138}" Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPeriodCommand}" CommandParameter="Month" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="Month" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{loc:Translate PeriodMonthSales}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#262138}" Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPeriodCommand}" CommandParameter="3 Months" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="3 Months" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{loc:Translate Period3MonthsSales}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </CollectionView.Footer>
        </CollectionView>
    </Grid>

</ContentPage>
