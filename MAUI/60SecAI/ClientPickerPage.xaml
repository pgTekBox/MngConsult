<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:_60SecAI.Services"
             xmlns:loc="clr-namespace:_60SecAI.Localization"
             x:Class="_60SecAI.ClientPickerPage"
             x:Name="Page"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F2F0FB, Dark=#141221}">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- En-tête : titre + Annuler -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,14">
            <Label x:Name="TitleLabel" Text="{loc:Translate ChooseClient}"
                   FontSize="20" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="{loc:Translate Cancel}"
                   TextColor="{StaticResource Primary}" FontAttributes="Bold" FontSize="15"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancel" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- Recherche -->
        <SearchBar Grid.Row="1" x:Name="Search"
                   Placeholder="{loc:Translate SearchPlaceholder}"
                   TextChanged="OnSearchChanged"
                   Margin="12,0" />

        <!-- Nouveau client -->
        <Button Grid.Row="2" x:Name="NewButton"
                Text="{loc:Translate NewClientButton}"
                Clicked="OnNewClicked"
                BackgroundColor="{StaticResource Primary}" TextColor="White"
                FontAttributes="Bold" HeightRequest="46" CornerRadius="12"
                Margin="12,8" IsVisible="False" />

        <!-- Liste -->
        <CollectionView Grid.Row="3" x:Name="List"
                        ItemsSource="{Binding Items, Source={x:Reference Page}}"
                        SelectionMode="Single" SelectionChanged="OnSelectionChanged"
                        Margin="12,0,12,12">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:ClientLookupDto">
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}"
                            StrokeThickness="0" Padding="14" Margin="0,0,0,8">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Label Text="{Binding DisplayName}" FontSize="15"
                               TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="{loc:Translate NoClientFound}" FontSize="13"
                       TextColor="{StaticResource Gray400}"
                       HorizontalTextAlignment="Center" Margin="0,24" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>

</ContentPage>
