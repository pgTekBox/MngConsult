<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:_60SecAI.Localization"
             x:Class="_60SecAI.NewInvoicePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F2F0FB, Dark=#141221}">

    <Grid RowDefinitions="Auto,*">

        <!-- En-tête simple avec retour -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="10"
              Padding="16,14">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackTapped" />
            </Grid.GestureRecognizers>
            <Label Grid.Column="0"
                   Text="&#8249;"
                   FontSize="30"
                   TextColor="{StaticResource Primary}"
                   VerticalOptions="Center" />
            <Label Grid.Column="1"
                   x:Name="HeaderTitle"
                   Text="{loc:Translate NewInvoice}"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}"
                   VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16"
                                 Spacing="16">

                <!-- ===== Carte : Client + dates ===== -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Label x:Name="PartyLabel"
                               Text="{loc:Translate ClientLabel}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray500}" />
                        <Border BackgroundColor="{AppThemeBinding Light=#F6F7FB, Dark=#262138}"
                                StrokeThickness="0" Padding="10,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Picker x:Name="ClientPicker" Title="Choisir un client"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                        </Border>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{loc:Translate BillingDate}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}" />
                                <Border BackgroundColor="{AppThemeBinding Light=#F6F7FB, Dark=#262138}" StrokeThickness="0" Padding="8,0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <DatePicker x:Name="BillDatePicker" Format="MM/dd/yyyy"
                                                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{loc:Translate DueDate}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}" />
                                <Border BackgroundColor="{AppThemeBinding Light=#F6F7FB, Dark=#262138}" StrokeThickness="0" Padding="8,0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <DatePicker x:Name="DueDatePicker" Format="MM/dd/yyyy"
                                                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label Text="{loc:Translate WorkDoneOn}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}" />
                                <Border BackgroundColor="{AppThemeBinding Light=#F6F7FB, Dark=#262138}" StrokeThickness="0" Padding="8,0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Entry x:Name="WorkDoneEntry" Placeholder="{loc:Translate DatePlaceholder}"
                                           BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}"
                                           HeightRequest="44" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ===== Carte : Lignes ===== -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Label Text="{loc:Translate Lines}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />

                        <Border BackgroundColor="{AppThemeBinding Light=#F6F7FB, Dark=#262138}" StrokeThickness="0" Padding="10,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Picker x:Name="LineTypePicker"
                                    BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Montant fixe</x:String>
                                        <x:String>Taux horaire</x:String>
                                        <x:String>Produit</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>

                        <Label Text="{loc:Translate Description}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}" />
                        <Border BackgroundColor="{AppThemeBinding Light=#F6F7FB, Dark=#262138}" StrokeThickness="0" Padding="10,4">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Editor x:Name="DescriptionEditor"
                                    BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}"
                                    HeightRequest="64" AutoSize="TextChanges" />
                        </Border>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                            <Label Grid.Row="0" Grid.Column="0" Text="{loc:Translate DateUpper}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                            <Border Grid.Row="0" Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F6F7FB, Dark=#262138}" StrokeThickness="0" Padding="8,0" HorizontalOptions="End" WidthRequest="160">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <DatePicker x:Name="LineDatePicker" Format="MM/dd/yyyy" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                            </Border>

                            <Label Grid.Row="1" Grid.Column="0" Text="{loc:Translate Quantity}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                            <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F6F7FB, Dark=#262138}" StrokeThickness="0" Padding="10,0" HorizontalOptions="End" WidthRequest="160">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Entry x:Name="QtyEntry" Text="0" Keyboard="Numeric"
                                       BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}"
                                       HorizontalTextAlignment="End" HeightRequest="44" TextChanged="OnAmountChanged" />
                            </Border>

                            <Label Grid.Row="2" Grid.Column="0" Text="{loc:Translate Price}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="160,Auto" ColumnSpacing="6" HorizontalOptions="End">
                                <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#F6F7FB, Dark=#262138}" StrokeThickness="0" Padding="10,0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Entry x:Name="PriceEntry" Text="0" Keyboard="Numeric"
                                           BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}"
                                           HorizontalTextAlignment="End" HeightRequest="44" TextChanged="OnAmountChanged" />
                                </Border>
                                <Label Grid.Column="1" Text="$" FontAttributes="Bold" TextColor="{StaticResource Gray500}" VerticalTextAlignment="Center" />
                            </Grid>
                        </Grid>

                        <!-- Actions ligne -->
                        <HorizontalStackLayout Spacing="24" HorizontalOptions="Center" Margin="0,4">
                            <Label Text="&#8593;" FontSize="20" TextColor="{StaticResource Gray500}">
                                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnLineActionTapped" CommandParameter="up" /></Label.GestureRecognizers>
                            </Label>
                            <Label Text="&#8595;" FontSize="20" TextColor="{StaticResource Gray500}">
                                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnLineActionTapped" CommandParameter="down" /></Label.GestureRecognizers>
                            </Label>
                            <Label Text="-$" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Gray500}">
                                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnLineActionTapped" CommandParameter="discount" /></Label.GestureRecognizers>
                            </Label>
                            <Label Text="&#128465;" FontSize="18" TextColor="#C0392B">
                                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnLineActionTapped" CommandParameter="delete" /></Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ===== Carte : Sommaire ===== -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">

                        <Label Text="{loc:Translate Summary}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{loc:Translate Subtotal}" FontSize="13" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="SubTotalLabel" Text="0,00 $" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{loc:Translate Gst}" FontSize="13" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="TpsLabel" Text="0,00 $" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{loc:Translate Qst}" FontSize="13" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="TvqLabel" Text="0,00 $" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EEE, Dark=#2E2942}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{loc:Translate Total}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="TotalLabel" Text="0,00 $" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        </Grid>

                        <!-- Payé + créer paiement -->
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="End" Margin="0,6,0,0">
                            <CheckBox x:Name="PaidCheck" Color="{StaticResource Primary}" CheckedChanged="OnPaidChanged" VerticalOptions="Center" />
                            <Label Text="{loc:Translate Paid}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" VerticalTextAlignment="Center" />
                            <Border BackgroundColor="#17A672" StrokeThickness="0" Padding="12,9">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCreatePaymentTapped" /></Border.GestureRecognizers>
                                <Label Text="{loc:Translate CreateNewPayment}" TextColor="White" FontAttributes="Bold" FontSize="13" />
                            </Border>
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <Label Grid.Column="0" Text="{loc:Translate Paid}" FontSize="13" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="PaidLabel" Text="0,00 $" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{loc:Translate TotalDue}" FontSize="15" FontAttributes="Bold" TextColor="#C0392B" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="TotalDueLabel" Text="0,00 $" FontSize="15" FontAttributes="Bold" TextColor="#C0392B" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Enregistrer -->
                <Button Text="{loc:Translate SaveInvoice}"
                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                        FontAttributes="Bold" FontSize="16"
                        HeightRequest="52" CornerRadius="26"
                        Margin="0,0,0,10"
                        Clicked="OnSaveInvoiceClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
