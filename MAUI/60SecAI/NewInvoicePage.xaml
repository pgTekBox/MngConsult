<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:_60SecAI.Localization"
             xmlns:vm="clr-namespace:_60SecAI.ViewModels"
             x:Class="_60SecAI.NewInvoicePage"
             x:Name="Page"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F2F0FB, Dark=#141221}">

    <Grid RowDefinitions="Auto,*">

        <!-- En-tête simple avec retour -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="10"
              Padding="16,14">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackTapped" />
            </Grid.GestureRecognizers>
            <Label Grid.Column="0"
                   Text="&#8249;"
                   FontSize="30"
                   TextColor="{StaticResource Primary}"
                   VerticalOptions="Center" />
            <Label Grid.Column="1"
                   x:Name="HeaderTitle"
                   Text="{loc:Translate NewInvoice}"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}"
                   VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16"
                                 Spacing="16">

                <!-- ===== Carte : Client + dates ===== -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Label x:Name="PartyLabel"
                               Text="{loc:Translate ClientLabel}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray500}" />
                        <Border BackgroundColor="{AppThemeBinding Light=#F6F7FB, Dark=#262138}"
                                StrokeThickness="0" Padding="12,0" HeightRequest="44">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPickPartyTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label x:Name="ClientValueLabel" Grid.Column="0"
                                       Text="{loc:Translate ChooseClient}"
                                       TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}"
                                       VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1" Text="&#9662;" FontSize="14"
                                       TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{loc:Translate BillingDate}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}" />
                                <Border BackgroundColor="{AppThemeBinding Light=#F6F7FB, Dark=#262138}" StrokeThickness="0" Padding="8,0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <DatePicker x:Name="BillDatePicker" Format="MM/dd/yyyy"
                                                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{loc:Translate DueDate}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}" />
                                <Border BackgroundColor="{AppThemeBinding Light=#F6F7FB, Dark=#262138}" StrokeThickness="0" Padding="8,0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <DatePicker x:Name="DueDatePicker" Format="MM/dd/yyyy"
                                                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ===== Carte : Lignes ===== -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <!-- Titre + Ajouter une ligne -->
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="{loc:Translate Lines}" FontSize="18" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="{loc:Translate AddLine}" Clicked="OnAddLineClicked"
                                    BackgroundColor="{StaticResource Primary}" TextColor="White"
                                    FontSize="13" FontAttributes="Bold" HeightRequest="38" CornerRadius="12" Padding="12,0" />
                        </Grid>

                        <!-- Liste des lignes -->
                        <VerticalStackLayout Spacing="10"
                                             BindableLayout.ItemsSource="{Binding Lines, Source={x:Reference Page}}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:InvoiceLineItem">
                                    <Border BackgroundColor="{AppThemeBinding Light=#F6F7FB, Dark=#262138}" StrokeThickness="0" Padding="12">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="8">

                                            <!-- Description (editable) + catalogue + supprimer -->
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1B1730}"
                                                        StrokeThickness="0" Padding="10,0" HeightRequest="42">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                                    <Entry Text="{Binding Description}" Placeholder="{loc:Translate DescriptionPlaceholder}"
                                                           HeightRequest="42" BackgroundColor="Transparent"
                                                           TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}"
                                                           PlaceholderColor="{StaticResource Gray400}" />
                                                </Border>
                                                <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=White, Dark=#1B1730}"
                                                        StrokeThickness="0" WidthRequest="42" HeightRequest="42">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnLineProductTapped" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="&#128203;" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <Label Grid.Column="2" Text="&#128465;" FontSize="18" TextColor="#C0392B"
                                                       VerticalOptions="Center" WidthRequest="28" HorizontalTextAlignment="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnLineDeleteTapped" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </Grid>

                                            <!-- Numero de compte + description (clic = nom du compte) -->
                                            <Label Text="{Binding AccountLabel}" FontSize="10"
                                                   TextColor="{StaticResource Gray400}" Margin="4,-2,0,0"
                                                   LineBreakMode="TailTruncation"
                                                   IsVisible="{Binding HasAccount}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnLineAccountTapped" />
                                                </Label.GestureRecognizers>
                                            </Label>

                                            <!-- Qté / Prix / Montant -->
                                            <Grid ColumnDefinitions="Auto,64,Auto,84,*" ColumnSpacing="6" VerticalOptions="Center">
                                                <Label Grid.Column="0" Text="{loc:Translate Quantity}" FontSize="12" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                                                <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=White, Dark=#1B1730}" StrokeThickness="0" Padding="8,0">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                                    <Entry Text="{Binding QtyText}" Keyboard="Numeric" HorizontalTextAlignment="End"
                                                           HeightRequest="40" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                                                </Border>
                                                <Label Grid.Column="2" Text="{loc:Translate Price}" FontSize="12" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                                                <Border Grid.Column="3" BackgroundColor="{AppThemeBinding Light=White, Dark=#1B1730}" StrokeThickness="0" Padding="8,0">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                                    <Entry Text="{Binding PriceText}" Keyboard="Numeric" HorizontalTextAlignment="End"
                                                           HeightRequest="40" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                                                </Border>
                                                <Label Grid.Column="4" Text="{Binding AmountText}" FontAttributes="Bold"
                                                       HorizontalTextAlignment="End" VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ===== Carte : Sommaire ===== -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#211C33}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">

                        <Label Text="{loc:Translate Summary}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{loc:Translate Subtotal}" FontSize="13" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="SubTotalLabel" Text="0,00 $" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{loc:Translate Gst}" FontSize="13" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="TpsLabel" Text="0,00 $" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{loc:Translate Qst}" FontSize="13" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="TvqLabel" Text="0,00 $" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EEE, Dark=#2E2942}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{loc:Translate Total}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="TotalLabel" Text="0,00 $" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        </Grid>

                        <!-- Payé + créer paiement -->
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="End" Margin="0,6,0,0">
                            <CheckBox x:Name="PaidCheck" Color="{StaticResource Primary}" CheckedChanged="OnPaidChanged" VerticalOptions="Center" />
                            <Label Text="{loc:Translate Paid}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" VerticalTextAlignment="Center" />
                            <Border BackgroundColor="#17A672" StrokeThickness="0" Padding="12,9">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCreatePaymentTapped" /></Border.GestureRecognizers>
                                <Label Text="{loc:Translate CreateNewPayment}" TextColor="White" FontAttributes="Bold" FontSize="13" />
                            </Border>
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <Label Grid.Column="0" Text="{loc:Translate Paid}" FontSize="13" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="PaidLabel" Text="0,00 $" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{loc:Translate TotalDue}" FontSize="15" FontAttributes="Bold" TextColor="#C0392B" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="TotalDueLabel" Text="0,00 $" FontSize="15" FontAttributes="Bold" TextColor="#C0392B" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Enregistrer -->
                <Button Text="{loc:Translate SaveInvoice}"
                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                        FontAttributes="Bold" FontSize="16"
                        HeightRequest="52" CornerRadius="26"
                        Margin="0,0,0,10"
                        Clicked="OnSaveInvoiceClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
