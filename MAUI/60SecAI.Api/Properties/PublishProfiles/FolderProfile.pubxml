<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>\\192.168.0.203\60SecAI_APIDeploy</PublishUrl>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
    <SiteUrlToLaunchAfterPublish />
    <TargetFramework>net10.0</TargetFramework>
    <ProjectGuid>9256a6e1-2beb-c052-08b2-bab649ad09a7</ProjectGuid>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!--
    Vide le CONTENU du repertoire de publication avant la copie
    (fichiers + sous-dossiers), sans supprimer la racine du partage
    (impossible car "tenue" par le service de partage => erreur "used by another process").
    DeleteExistingFiles reste a false pour la meme raison.
  -->
  <Target Name="EmptyPublishFolderBeforeCopy"
          BeforeTargets="FileSystemPublish;Publish"
          Condition="'$(PublishUrl)' != '' And Exists('$(PublishUrl)')">
    <Message Importance="high" Text="Vidage du repertoire de publication avant copie : $(PublishUrl)" />
    <ItemGroup>
      <_PublishExistingFiles Include="$([System.IO.Directory]::GetFiles('$(PublishUrl)'))" />
      <_PublishExistingDirs Include="$([System.IO.Directory]::GetDirectories('$(PublishUrl)'))" />
    </ItemGroup>
    <Delete Files="@(_PublishExistingFiles)" ContinueOnError="true" />
    <RemoveDir Directories="@(_PublishExistingDirs)" ContinueOnError="true" />
  </Target>
</Project>