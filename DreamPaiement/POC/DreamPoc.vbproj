<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DreamPoc</RootNamespace>
    <AssemblyName>DreamPoc</AssemblyName>
    <StartupObject>DreamPoc.Program</StartupObject>
    <MyType>Empty</MyType>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionExplicit>On</OptionExplicit>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <Product>POC Dream Payments pour MngConsul</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Chiffre le secret client pour l'utilisateur Windows (DPAPI). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System.Drawing" />
    <Import Include="System.IO" />
    <Import Include="System.Text.Json.Nodes" />
    <Import Include="System.Threading" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
