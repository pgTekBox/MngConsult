<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- La chaîne de connexion « Paie » est dans ConnectionStrings.config, exclu de git parce qu'il peut contenir le mot de passe
       du serveur SQL. Pour le créer : copier ConnectionStrings.exemple.config sous ce nom. -->
  <connectionStrings configSource="ConnectionStrings.config" />

  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <!-- DÉVELOPPEMENT SEULEMENT : mots de passe courts permis. Retiré par Web.Release.config (minimum de 10 en production). -->

    <!-- Talons par courriel. L'expéditeur doit appartenir à 60sec.ca : une autre adresse
         est refusée (SPF et DMARC du domaine de l'employeur rejetteraient le message).
         Vide = paie@60sec.ca. L'adresse de la compagnie sert de Reply-To. -->
    <add key="Courriel:Expediteur" value="" />
    <!-- DÉVELOPPEMENT SEULEMENT : les courriels sont écrits en fichiers .eml dans ce dossier au lieu d'être envoyés.
         Retiré par Web.Release.config ; en production, configurer system.net/mailSettings ci-dessous. -->
    <add key="Courriel:DossierTest" value="~/App_Data/courriels" />
    <!-- Par où sortent les courriels. Vide = automatique : le dossier d'essai ci-dessus
         l'emporte, et à défaut le service d'envoi de la plateforme (connexion « Mail »
         vers MailService, relevée par SrvAI).
         « service » force la remise réelle MÊME en développement — à écrire soi-même,
         pour qu'un envoi de talons ne soit jamais le fruit d'un oubli.
         « smtp » force le chemin SMTP. -->
    <add key="Courriel:Transport" value="" />
  </appSettings>

  <!-- Serveur SMTP de production (exiger TLS). Garder le mot de passe hors du dépôt : configSource ou variable du serveur.
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network" from="paie@votre-domaine.ca">
        <network host="smtp.votre-fournisseur.ca" port="587" enableSsl="true" userName="..." password="..." />
      </smtp>
    </mailSettings>
  </system.net>
  -->

  <system.web>
    <compilation debug="true" strict="true" explicit="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" />
    <globalization culture="fr-CA" uiCulture="fr-CA" fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />

    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" defaultUrl="~/Default.aspx" name=".60secPaie" timeout="60" slidingExpiration="true"
             protection="All" requireSSL="false" cookieless="UseCookies" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>

    <sessionState timeout="60" cookieless="UseCookies" />
    <httpCookies httpOnlyCookies="true" />
    <customErrors mode="RemoteOnly" />

    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" viewStateEncryptionMode="Always">
      <namespaces>
        <add namespace="Paie60Sec.Web" />
      </namespaces>
    </pages>
  </system.web>

  <!-- La page de présentation est la seule page ouverte aux visiteurs. Tout le
       reste du service exige une session : la règle globale reste deny users="?". -->
  <location path="Aide.html">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Aide-en.html">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Aide-es.html">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Accueil.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <!-- La racine du site montre la présentation, pas le tableau de bord : un
         visiteur non connecté serait sinon renvoyé vers la page de connexion
         sans jamais savoir ce qu'on lui propose. -->
    <defaultDocument>
      <files>
        <clear />
        <add value="Accueil.aspx" />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
