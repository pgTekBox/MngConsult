<?xml version="1.0" encoding="utf-8"?>
<!--
  Modèle de ConnectionStrings.config. Copiez ce fichier sous le nom « ConnectionStrings.config » (exclu de git)
  et gardez UNE seule entrée « Paie » active. Le mot de passe ne doit exister que dans ConnectionStrings.config.
  Les tables de 60secPaie sont dans le schéma « paie » de la base.
-->
<connectionStrings>
  <!-- Développement : SQL Server LocalDB, authentification Windows (aucun mot de passe). -->
  <add name="Paie"
       connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=60secPaie;Integrated Security=True;MultipleActiveResultSets=True"
       providerName="System.Data.SqlClient" />

  <!-- Serveur : base partagée MngConsul. Remplacez VOTRE_MOT_DE_PASSE, puis mettez l'entrée LocalDB ci-dessus en commentaire.
  <add name="Paie"
       connectionString="Data Source=192.168.0.203;Initial Catalog=MngConsul;User ID=MngConsul;Password=VOTRE_MOT_DE_PASSE;TrustServerCertificate=True;MultipleActiveResultSets=True"
       providerName="System.Data.SqlClient" />
  -->
</connectionStrings>
