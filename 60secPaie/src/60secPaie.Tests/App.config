<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Base jetable, recréée à chaque exécution des tests d'intégration. Jamais la base de développement. -->
    <add name="Paie"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=60secPaie_Test;Integrated Security=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
