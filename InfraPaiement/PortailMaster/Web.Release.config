<?xml version="1.0" encoding="utf-8"?>
<!--
  Transformations appliquées au PUBLISH en Release (production).
  Le dev local (Debug) utilise Web.config tel quel : ces réglages ne
  s'appliquent donc PAS en développement.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <!-- Retirer le mode debug (perf + pas de fuite de détails). -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />

    <!-- Erreurs génériques : jamais de stack trace au client. -->
    <customErrors mode="On" defaultRedirect="~/Error.aspx"
                  xdt:Transform="Replace">
      <error statusCode="404" redirect="~/Error.aspx" />
      <error statusCode="500" redirect="~/Error.aspx" />
    </customErrors>

    <!-- Cookies (session, remember-me) transmis uniquement en HTTPS. -->
    <httpCookies requireSSL="true" xdt:Transform="SetAttributes(requireSSL)" />

    <!-- Ne pas divulguer la version ASP.NET. -->
    <httpRuntime enableVersionHeader="false" xdt:Transform="SetAttributes(enableVersionHeader)" />
  </system.web>

  <system.webServer>
    <!-- Pas d'erreurs IIS détaillées côté client. -->
    <httpErrors errorMode="Custom" existingResponse="Auto" xdt:Transform="SetAttributes(errorMode,existingResponse)" />

    <httpProtocol>
      <customHeaders>
        <!-- HSTS : force HTTPS pendant 1 an. -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" xdt:Transform="Insert" />
        <!-- Masquer l'en-tête X-Powered-By. -->
        <remove name="X-Powered-By" xdt:Transform="Insert" />
      </customHeaders>
    </httpProtocol>

    <!-- Redirection HTTP -> HTTPS (module URL Rewrite requis sur IIS).
         Localhost exclu pour ne pas gêner un éventuel test local. -->
    <rewrite xdt:Transform="Insert">
      <rules>
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^localhost" negate="true" />
            <add input="{HTTP_HOST}" pattern="^127\.0\.0\.1" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
