<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="Site.master.vb" Inherits="MngConsul.SiteMaster" %>

<%@ Register Src="~/Controls/Header.ascx" TagPrefix="uc" TagName="Header" %>
<%@ Register Src="~/Controls/LeftMenu.ascx" TagPrefix="uc" TagName="LeftMenu" %>
<%@ Register Src="~/Controls/Footer.ascx" TagPrefix="uc" TagName="Footer" %>

<!DOCTYPE html>
<html lang="fr">
<head runat="server">
<meta charset="utf-8" />
 

<title><asp:ContentPlaceHolder ID="TitleContent" runat="server" /></title>

<style>
/* =========================
   THEME (LIGHT)
========================= */
:root{
    --mc-bg:#f6f7fb;
    --mc-card:#ffffff;
    --mc-muted:#64748b;
    --mc-text:#0f172a;
    --mc-stroke: rgba(15,23,42,.12);
    --mc-shadow: 0 14px 40px rgba(2,6,23,.10);
    --mc-radius: 16px;
    --mc-font: system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
    --mc-blue:#2563eb;
    --mc-cyan:#06b6d4;
}

*{ box-sizing:border-box; }

html, body, form{
    min-height:100%;
    height:auto;
}

body{
    margin:0;
    font-family:var(--mc-font);
    background:
        radial-gradient(900px 450px at 20% 0%, rgba(37,99,235,.14), transparent 60%),
        radial-gradient(900px 450px at 80% 0%, rgba(6,182,212,.10), transparent 60%),
        var(--mc-bg);
    color:var(--mc-text);
    overflow-y: scroll; /* garde toujours la scrollbar */
}

a{
    color:inherit;
    text-decoration:none;
}

/* APP */
.mc-app{
    min-height: calc(100vh - 60px);
    display:grid;
    grid-template-rows:auto 1fr auto;
}

.mc-shell{
    display:grid;
    grid-template-columns:270px minmax(0,1fr);
    gap:16px;
    padding:16px;
    width:100%;
    min-width:0;
}

.mc-sidebar{
    position:sticky;
    top:16px;
    align-self:start;
    z-index:1;
    margin-right:10px;
}

.mc-maincol{
    min-width:0;
    position:relative;
    display:flex;
    flex-direction:column;
}

.mc-card{
    background:rgba(255,255,255,.92);
    border:1px solid var(--mc-stroke);
    border-radius:var(--mc-radius);
    box-shadow:var(--mc-shadow);
    overflow:hidden;
    display:flex;
    flex-direction:column;
    min-width:0;
}

.mc-mainwrap{
    flex:1 1 auto;
    display:flex;
    flex-direction:column;
    min-height:0;
    min-width:0;
}

.pad{ padding:16px; }

.toolbar{
    display:flex;
    gap:10px;
    align-items:center;
    justify-content:space-between;
    padding:14px 16px;
    border-bottom:1px solid var(--mc-stroke);
    background:rgba(255,255,255,.75);
}

.toolbar .title{
    font-size:16px;
    font-weight:800;
}
 

.input{
    width:min(360px,55vw);
    padding:10px 12px;
    border-radius:12px;
    border:1px solid var(--mc-stroke);
    background:#ffffff;
    color:var(--mc-text);
    outline:none;
}

.input::placeholder{
    color:rgba(15,23,42,.55);
}

.btn{
    cursor:pointer;
    border:1px solid var(--mc-stroke);
    border-radius:12px;
    padding:10px 12px;
    background:linear-gradient(135deg, rgba(37,99,235,.14), rgba(6,182,212,.10));
    color:var(--mc-text);
    font-weight:800;
}

.btn:hover{ filter:brightness(0.98); }
.btn:active{ transform:translateY(1px); }

.pill{
    display:inline-block;
    padding:5px 10px;
    border-radius:999px;
    font-size:12px;
    border:1px solid var(--mc-stroke);
    background:rgba(2,6,23,.03);
    color:var(--mc-text);
}

.RadGrid{
    background:transparent !important;
}
/* =========================
            TABLETTE — 769px à 1024px
         ========================= */
        @media   (max-width: 1024px) {
             
        }

/* =========================
             MOBILE LARGE  grands smartphones en portrait
========================= */
        @media  (max-width: 768px) {



    .app-header {
        display: none;
    }


  

    .mc-sidebar{
        position:relative;
        top:auto;
        margin-right:0;
    }
        }
    /* =========================
         PETIT MOBILE — max 480px
           ========================= */
        @media (max-width: 480px) {


          
        }


 
</style>


<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>

<body>
<form id="form1" runat="server">

    <!-- ⭐ TERTELIK GLOBAL -->
    <telerik:RadScriptManager
        ID="RadScriptManager1"
        runat="server"
        EnablePartialRendering="true"
        AsyncPostBackTimeout="300" />

    <div class="mc-app">

        <!-- HEADER -->
        <uc:Header runat="server" ID="Header1" />

        <div class="mc-shell">

            <!-- SIDEBAR -->
            <aside class="mc-sidebar">
                <div class="mc-card">
                    <uc:LeftMenu runat="server" ID="LeftMenu1" />
                </div>
            </aside>

            <!-- MAIN CONTENT -->
            <main class="mc-maincol">
                <div class="mc-card mc-mainwrap">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </div>
            </main>

        </div>

        <!-- FOOTER -->
        <uc:Footer runat="server" ID="Footer1" />

    </div>

    <%-- Boîte de message applicative, disponible sur toutes les pages du master.
         Remplace radalert() : appelé depuis un script de démarrage
         (ScriptManager.RegisterStartupScript), radalert s'exécute AVANT que Telerik
         ait créé son RadWindowManager côté client et lève « Cannot read properties
         of undefined (reading 'radalert') ». L'exception interrompt le traitement de
         la réponse AJAX, après quoi la page ne réagit plus aux clics.
         Côté serveur : clsData.ShowMessageBox(message, titre). --%>
    <div id="mcMsgOverlay" style="display:none; position:fixed; inset:0; z-index:999999;
         background:rgba(15,23,42,.55); align-items:center; justify-content:center;"
         onclick="if (event.target === this) closeAppMessage();">
        <div style="background:#fff; border-radius:16px; box-shadow:0 20px 60px rgba(0,0,0,.3);
             width:92vw; max-width:460px; padding:24px; box-sizing:border-box;
             font-family:inherit;">
            <div id="mcMsgTitle" style="font-weight:800; font-size:16px; color:#0f172a;
                 margin-bottom:10px;"></div>
            <div id="mcMsgText" style="color:#475569; font-size:14px; line-height:1.5;
                 margin-bottom:22px; white-space:pre-wrap;"></div>
            <div style="display:flex; justify-content:flex-end;">
                <button type="button" onclick="closeAppMessage()"
                    style="padding:10px 18px; border:1px solid #2563eb; background:#2563eb;
                           color:#fff; border-radius:10px; font-weight:700; cursor:pointer;">OK</button>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        // textContent et non innerHTML : les messages contiennent des données
        // (nom de client, courriel, message d'erreur d'API).
        function showAppMessage(text, title) {
            var o = document.getElementById("mcMsgOverlay");
            var t = document.getElementById("mcMsgText");
            var h = document.getElementById("mcMsgTitle");
            if (!o || !t) { return; }
            t.textContent = text || "";
            if (h) { h.textContent = title || "Information"; }
            o.style.display = "flex";
        }
        function closeAppMessage() {
            var o = document.getElementById("mcMsgOverlay");
            if (o) { o.style.display = "none"; }
        }
        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") { closeAppMessage(); }
        });
    </script>

</form>
</body>
</html>
