<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <!-- TLS 1.2 est exige par api.openai.com : sans cette ligne, .NET 4.7.2
       negocie parfois un protocole refuse et l'appel echoue en "connexion
       fermee de facon inattendue". -->
  <runtime>
    <AppContextSwitchOverrides value="Switch.System.Net.DontEnableSchUseStrongCrypto=false" />
  </runtime>
</configuration>
